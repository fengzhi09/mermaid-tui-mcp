{
    "name": "@acer_09/mermaid-tui-mcp",
    "version": "0.3.0",
    "description": "Local mermaid rendering service for gsd-pi. stdio MCP server (default) for the live command-box flow; HTTP 127.0.0.1:5300 in standalone mode for browser view pages. 7-day TTL with optional pin.",
    "keywords": [
        "mermaid",
        "mcp",
        "model-context-protocol",
        "diagram",
        "ascii",
        "tui",
        "agent",
        "claude-code",
        "gsd-pi",
        "opencode",
        "hermes",
        "openclaw"
    ],
    "homepage": "https://gitee.com/fengzhi09/mermaid-tui-mcp#readme",
    "bugs": {
        "url": "https://gitee.com/fengzhi09/mermaid-tui-mcp/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://gitee.com/fengzhi09/mermaid-tui-mcp.git"
    },
    "license": "MIT",
    "author": "lhl",
    "type": "module",
    "main": "src/server.mjs",
    "bin": {
        "mermaid-tui-mcp": "src/server.mjs"
    },
    "directories": {
        "doc": "docs",
        "test": "tests"
    },
    "files": [
        "src",
        "bin",
        "public",
        "extensions",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "start": "node src/server.mjs",
        "start:http": "MERMAID_RENDERER_HTTP=1 node src/server.mjs",
        "dev": "node --watch src/server.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1062.0",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "beautiful-mermaid": "^1.1.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^3.2.6",
        "vitest": "^3.2.6"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "mcpServers": {
        "_comment": "Documented for /gsd mcp init reference; user copies into .gsd/mcp.json or ~/.gsd/mcp.json",
        "gsd-mermaid": {
            "command": "npx",
            "args": [
                "-y",
                "@acer_09/mermaid-tui-mcp"
            ]
        }
    }
}
