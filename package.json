{
  "name": "mermaid-tui-mcp",
  "version": "0.2.0",
  "description": "Local mermaid rendering service for gsd-pi. stdio MCP server (default) for the live command-box flow; HTTP 127.0.0.1:5300 in standalone mode for browser view pages. 7-day TTL with optional pin.",
  "type": "module",
  "private": true,
  "main": "src/server.mjs",
  "bin": {
    "gsd-mermaid-renderer": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:http": "MERMAID_RENDERER_HTTP=1 node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jsdom": "^25.0.0",
    "mermaid": "^11.15.0",
    "mermaid-ascii": "^1.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "mcpServers": {
    "_comment": "Documented for /gsd mcp init reference; user copies into .gsd/mcp.json or ~/.gsd/mcp.json",
    "gsd-mermaid": {
      "command": "node",
      "args": [
        "${workspaceFolder}/src/server.mjs"
      ]
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "vitest": "^3.2.6"
  }
}
