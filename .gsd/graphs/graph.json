    {
      "id": "pattern:P001",
      "label": "P001",
      "type": "pattern",
      "description": "Structured stderr JSON logger: `log({level=\"info\", event, code?, id?, ...rest})` writes one line per call to `process.stderr` with stable field order `{ts, level, event, code, id, ...rest}`. `code` and `id` are OMITTED (not null) when null/undefined.",
      "confidence": "EXTRACTED",
      "sourceFile": "KNOWLEDGE.md"
    },
    {
      "id": "pattern:P002",
      "label": "P002",
      "type": "pattern",
      "description": "Persistent counters via tmp+rename atomic write: write to `<root>/counters.json.tmp` then `rename()` to the real path. Best-effort unlink of a stale `.tmp` on `load()` recovers from mid-rename crashes.",
      "confidence": "EXTRACTED",
      "sourceFile": "KNOWLEDGE.md"
    },
    {
      "id": "pattern:P003",
      "label": "P003",
      "type": "pattern",
      "description": "Forward-compat counter keys: `increment(unknownKey)` creates the key with default 0 and persists it. The 6 documented `COUNTER_KEYS` are seeded on `load()`; extras are preserved across a new `Counters` instance.",
      "confidence": "EXTRACTED",
      "sourceFile": "KNOWLEDGE.md"
    },
